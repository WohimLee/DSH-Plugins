{
  "name": "dsh-{{slug}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{slug}}：待实现的 DSH 插件示例。",
  "type": "module",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.5"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "pnpm build && pnpm test",
    "test": "node --test tests/*.test.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.5",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.5",
    "react": "18.3.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "esbuild": "0.28.2",
    "@types/react": "18.3.31",
    "react-dom": "18.3.1"
  }
}
