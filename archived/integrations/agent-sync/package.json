{
  "name": "dsh-agent-sync",
  "version": "0.1.1",
  "private": true,
  "description": "将本机 Codex 项目、工作目录和会话同步到 DSH 工作台。",
  "type": "module",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.4 <0.2.3-0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "pnpm build && pnpm test",
    "test": "node --test tests/*.test.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.2-rc.4 <0.2.3-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-rc.4 <0.2.3-0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.2-rc.4 <0.2.3-0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.2-rc.4 <0.2.3-0",
    "react": "18.3.1",
    "@deepseek-ai/dsh-api-gateway": ">=0.2.2-rc.4 <0.2.3-0",
    "@deepseek-ai/dsh-typert-registry": ">=0.2.2-rc.4 <0.2.3-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.4 <0.2.3-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.4 <0.2.3-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.5",
    "react": "18.3.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "esbuild": "0.28.2",
    "@types/react": "18.3.31",
    "react-dom": "18.3.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5"
  },
  "dependencies": {
    "zod": "4.6.6"
  }
}
