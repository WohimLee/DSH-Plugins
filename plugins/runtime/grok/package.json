{
  "name": "dsh-grok",
  "version": "0.1.1",
  "private": true,
  "description": "使用 xAI API Key 将 Grok 语言模型接入 DSH 模型选择器。",
  "type": "module",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.5"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "pnpm build && pnpm test",
    "test": "node --test tests/*.test.mjs",
    "prepack": "pnpm build",
    "test:host": "pnpm build && node tests/host.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.5",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.5",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.5",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.5",
    "react": "18.3.1",
    "@deepseek-ai/dsh": "0.2.2-rc.5",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "playwright-core": "1.62.1",
    "@dsh-plugins/macos-proxy": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-fs": {
      "optional": true
    }
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "zod": "4.6.7",
    "undici": "8.11.2"
  }
}
