{
  "name": "dsh-qoder",
  "version": "0.1.14",
  "private": true,
  "description": "通过 Qoder Agent SDK 将 Qoder 模型接入 DSH 原生模型循环。",
  "type": "module",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.5"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "pnpm build && pnpm test",
    "test": "node --test tests/*.test.mjs",
    "prepack": "pnpm build",
    "test:host": "pnpm build && node tests/host.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.5",
    "react": "18.3.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh": "0.2.2-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.5",
    "react": "18.3.1",
    "@types/react": "18.3.31",
    "esbuild": "0.28.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@qoder-ai/qoder-agent-sdk": "1.0.59",
    "zod": "4.6.7"
  }
}
