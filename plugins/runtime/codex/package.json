{
  "name": "dsh-codex",
  "version": "0.1.8",
  "private": true,
  "description": "将本机 Codex 登录可用的模型接入 DSH 原生模型循环。",
  "type": "module",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.4 <0.2.3-0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "pnpm build && pnpm test",
    "test": "node --test tests/*.test.mjs",
    "prepack": "pnpm build",
    "test:host": "pnpm build && node tests/host.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.4 <0.2.3-0",
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "esbuild": "0.28.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh": "0.2.2-rc.5",
    "@dsh-plugins/macos-proxy": "workspace:*"
  },
  "dependencies": {
    "undici": "8.11.2"
  }
}
